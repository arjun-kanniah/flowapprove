# Copy to .env (git-ignored). Real values never go in git.

# Local Postgres from docker-compose (the default when unset)
DATABASE_URL=postgresql://flowapprove:flowapprove@localhost:5433/flowapprove

# Requests at or above this amount (in dollars) also need finance approval
APPROVAL_FINANCE_THRESHOLD=1000

# AI quote check: set at least one key to enable it
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
