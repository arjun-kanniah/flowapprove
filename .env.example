# Copy to .env (git-ignored). Real values never go in git.

# Local Postgres from docker-compose (the default when unset)
DATABASE_URL=postgresql://flowapprove:flowapprove@localhost:5433/flowapprove

# Requests at or above this amount (in dollars) also need finance approval
APPROVAL_FINANCE_THRESHOLD=1000

# AI quote check: the model as provider/model, and that provider's key. Without the key the
# check is switched off. Options: anthropic/claude-haiku-5-5 (default), claude-sonnet-5-5,
# claude-opus-5-5; openai/gpt-6-luna, gpt-6.1-sol; gemini/gemini-3.5-flash-lite, gemini-3.8-flash
QUOTE_CHECK_MODEL=anthropic/claude-haiku-5-5
QUOTE_CHECKS_PER_HOUR=10
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
