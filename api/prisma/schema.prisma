// FlowApprove's data model. Statuses, steps and roles mirror src/workflow.ts, where the
// approval rules live.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  requester
  manager
  finance
  admin
}

enum Status {
  draft
  pending_manager
  pending_finance
  changes_requested
  approved
  rejected
  cancelled
}

enum Step {
  manager
  finance
}

enum DecisionAction {
  approve
  reject
  request_changes
}

enum EmailStatus {
  pending
  sent
  logged
  failed
}

enum AiCheckStatus {
  running
  done
  failed
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  name          String
  roles         Role[]
  managerId     String?  @map("manager_id") @db.Uuid
  manager       User?    @relation("Reports", fields: [managerId], references: [id], onDelete: SetNull)
  reports       User[]   @relation("Reports")
  /// Set the first time this person signs in with Entra ID
  entraObjectId String?  @unique @map("entra_object_id")
  /// A persona on the public demo, reset with the demo data
  isDemo        Boolean  @default(false) @map("is_demo")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  requests        PurchaseRequest[] @relation("Requester")
  managedRequests PurchaseRequest[] @relation("Manager")
  decisions       Decision[]
  attachments     Attachment[]
  auditEvents     AuditEvent[]
  emails          EmailMessage[]

  @@map("users")
}

model PurchaseRequest {
  id                String    @id @default(uuid()) @db.Uuid
  title             String
  description       String    @default("")
  vendor            String
  category          String
  amountCents       Int       @map("amount_cents")
  currency          String    @default("USD") @db.Char(3)
  status            Status    @default(draft)
  requesterId       String    @map("requester_id") @db.Uuid
  requester         User      @relation("Requester", fields: [requesterId], references: [id])
  /// The requester's manager when it was submitted, who decides the manager step
  managerId         String?   @map("manager_id") @db.Uuid
  manager           User?     @relation("Manager", fields: [managerId], references: [id])
  /// Who approved the manager step; finance must be someone else
  managerApproverId String?   @map("manager_approver_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  submittedAt       DateTime? @map("submitted_at") @db.Timestamptz
  closedAt          DateTime? @map("closed_at") @db.Timestamptz

  attachments Attachment[]
  decisions   Decision[]
  auditEvents AuditEvent[]
  aiChecks    AiCheck[]
  emails      EmailMessage[]

  @@index([requesterId, createdAt])
  @@index([managerId, status])
  @@index([status])
  @@map("purchase_requests")
}

model Attachment {
  id           String          @id @default(uuid()) @db.Uuid
  requestId    String          @map("request_id") @db.Uuid
  request      PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  filename     String
  contentType  String          @map("content_type")
  sizeBytes    Int             @map("size_bytes")
  sha256       String          @db.Char(64)
  /// Where the file lives: a local path in development, a blob name in Azure
  storageKey   String          @unique @map("storage_key")
  uploadedById String          @map("uploaded_by_id") @db.Uuid
  uploadedBy   User            @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  aiChecks     AiCheck[]

  @@index([requestId])
  @@map("attachments")
}

model Decision {
  id        String          @id @default(uuid()) @db.Uuid
  requestId String          @map("request_id") @db.Uuid
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  step      Step
  action    DecisionAction
  actorId   String          @map("actor_id") @db.Uuid
  actor     User            @relation(fields: [actorId], references: [id])
  comment   String          @default("")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@index([requestId, createdAt])
  @@map("decisions")
}

/// Append-only: a database trigger rejects updates and deletes (see the init migration).
model AuditEvent {
  id         BigInt           @id @default(autoincrement())
  requestId  String?          @map("request_id") @db.Uuid
  request    PurchaseRequest? @relation(fields: [requestId], references: [id], onDelete: NoAction)
  actorId    String?          @map("actor_id") @db.Uuid
  actor      User?            @relation(fields: [actorId], references: [id], onDelete: NoAction)
  action     String
  fromStatus Status?          @map("from_status")
  toStatus   Status?          @map("to_status")
  details    Json             @default("{}")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([requestId, createdAt])
  @@index([createdAt])
  @@map("audit_events")
}

model AiCheck {
  id           String          @id @default(uuid()) @db.Uuid
  requestId    String          @map("request_id") @db.Uuid
  request      PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  attachmentId String          @map("attachment_id") @db.Uuid
  attachment   Attachment      @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  provider     String
  model        String
  status       AiCheckStatus   @default(running)
  /// match | mismatch | unclear, once done
  verdict      String?
  findings     Json            @default("[]")
  inputTokens  Int             @default(0) @map("input_tokens")
  outputTokens Int             @default(0) @map("output_tokens")
  error        String?
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@index([requestId, createdAt])
  @@map("ai_checks")
}

/// Outbox: written in the same transaction as the change it reports, then delivered by a
/// background worker, so a decision is never saved without its notification.
model EmailMessage {
  id          String           @id @default(uuid()) @db.Uuid
  toUserId    String           @map("to_user_id") @db.Uuid
  toUser      User             @relation(fields: [toUserId], references: [id], onDelete: Cascade)
  toAddress   String           @map("to_address")
  requestId   String?          @map("request_id") @db.Uuid
  request     PurchaseRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// What it's about, e.g. approval_needed, approved
  kind        String
  subject     String
  text        String
  status      EmailStatus      @default(pending)
  attempts    Int              @default(0)
  nextAttempt DateTime         @default(now()) @map("next_attempt") @db.Timestamptz
  lastError   String?          @map("last_error")
  sentAt      DateTime?        @map("sent_at") @db.Timestamptz
  readAt      DateTime?        @map("read_at") @db.Timestamptz
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([status, nextAttempt])
  @@index([toUserId, createdAt])
  @@map("email_messages")
}
